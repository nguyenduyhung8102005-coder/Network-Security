<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox minHeight="720.0" minWidth="960.0" prefHeight="720.0" prefWidth="960.0" spacing="25.0" stylesheets="@styles.css" style="-fx-background-color: #f1f5f9; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://github.com/fxml/1" fx:controller="com.anm.digisign.controller.MainViewController">

    <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: linear-gradient(to right, #ffffff, #f8fafc); -fx-padding: 20 30 20 30; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;">
        <children>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <children>
                    
                    <Label text="Hệ Thống Xác Thực Chữ Ký Số RSA &amp; Kiểm Tra Toàn Vẹn" textFill="#0f172a">
                        <font>
                            <Font name="Segoe UI Bold" size="22.0" />
                        </font>
                    </Label>
                    <Label text="Bảo mật - Đảm bảo tính nguyên vẹn của văn bản số" textFill="#64748b">
                        <font>
                            <Font name="Segoe UI" size="13.0" />
                        </font>
                    </Label>
                </children>
            </VBox>
        </children>
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
             style="-fx-background-color: transparent;
                    -fx-tab-min-width: 180px;
                    -fx-tab-min-height: 45px;
                    -fx-tab-max-height: 45px;
                    -fx-cursor: hand;">
        <tabs>

            <Tab style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold;" text="📊 1. Tổng Quan">
                <content>
                    <VBox spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 0 12 12 12; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 8); -fx-border-color: #e2e8f0; -fx-border-radius: 0 12 12 12; -fx-border-width: 1;">
                        <children>
                            <VBox spacing="8.0">
                                <Label text="Báo Cáo Hoạt Động Hệ Thống" textFill="#0f172a">
                                    <font>
                                        <Font name="Segoe UI Bold" size="18.0" />
                                    </font>
                                </Label>

                            </VBox>

                            <HBox spacing="30.0" alignment="CENTER">
                                <children>
                                    <VBox alignment="CENTER" prefWidth="300.0" spacing="15.0" style="-fx-background-color: #fff7ed; -fx-border-color: #fdba74; -fx-border-radius: 15; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(249,115,22,0.1), 10, 0, 0, 5);">
                                        <children>
                                            <Label text="✍️ VĂN BẢN ĐÃ KÝ" textFill="#c2410c">
                                                <font>
                                                    <Font name="Segoe UI Bold" size="14.0" />
                                                </font>
                                            </Label>
                                            <Label fx:id="lblSignedCount" text="0" textFill="#ea580c">
                                                <font>
                                                    <Font name="Segoe UI Black" size="48.0" />
                                                </font>
                                            </Label>
                                            <Label text="Tài liệu được bảo mật thành công" textFill="#9a3412">
                                                <font>
                                                    <Font name="Segoe UI" size="12.0" />
                                                </font>
                                            </Label>
                                        </children>
                                    </VBox>

                                    <VBox alignment="CENTER" prefWidth="300.0" spacing="15.0" style="-fx-background-color: #eff6ff; -fx-border-color: #93c5fd; -fx-border-radius: 15; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.1), 10, 0, 0, 5);">
                                        <children>
                                            <Label text="🛡️ VĂN BẢN ĐÃ XÁC THỰC" textFill="#1d4ed8">
                                                <font>
                                                    <Font name="Segoe UI Bold" size="14.0" />
                                                </font>
                                            </Label>
                                            <Label fx:id="lblVerifiedCount" text="0" textFill="#2563eb">
                                                <font>
                                                    <Font name="Segoe UI Black" size="48.0" />
                                                </font>
                                            </Label>
                                            <Label text="Kiểm tra tính nguyên vẹn hoàn tất" textFill="#1e40af">
                                                <font>
                                                    <Font name="Segoe UI" size="12.0" />
                                                </font>
                                            </Label>
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>

                            <Separator style="-fx-opacity: 0.4;" />
                        </children>
                    </VBox>
                </content>
            </Tab>

            <Tab style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold;" text="🔑 2. Quản Lý Khóa RSA">
                <content>
                    <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 0 12 12 12; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 8); -fx-border-color: #e2e8f0; -fx-border-radius: 0 12 12 12; -fx-border-width: 1;">
                        <children>
                            <VBox spacing="8.0">
                                <Label text="Khởi Tạo &amp; Phân Phối Khóa Bảo Mật" textFill="#0f172a">
                                    <font>
                                        <Font name="Segoe UI Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Label text="Hệ thống sử dụng thuật toán RSA (Rivest–Shamir–Adleman) để sinh cặp khóa bất đối xứng. Public Key dùng để xác thực, Private Key dùng để ký." textFill="#64748b" wrapText="true">
                                    <font>
                                        <Font name="Segoe UI" size="14.0" />
                                    </font>
                                </Label>
                            </VBox>

                            <Separator style="-fx-opacity: 0.4;" />

                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                                <children>
                                    <Button onAction="#handleGenerateKeys" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 24; -fx-effect: dropshadow(three-pass-box, rgba(16,185,129,0.3), 8, 0, 0, 3); -fx-cursor: hand;" text="Sinh Cặp Khóa Mới (RSA 2048)" />
                                    <Button onAction="#handleExportPublicKey" style="-fx-background-color: white; -fx-text-fill: #3b82f6; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 24; -fx-border-color: #3b82f6; -fx-border-radius: 8; -fx-border-width: 2; -fx-cursor: hand;" text="⬇ Xuất Public Key (.pub)" />
                                    <Button onAction="#handleExportPrivateKey" style="-fx-background-color: white; -fx-text-fill: #ef4444; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 24; -fx-border-color: #ef4444; -fx-border-radius: 8; -fx-border-width: 2; -fx-cursor: hand;" text="⬇ Xuất Private Key (Base64)" />
                                </children>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 18 20; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-border-style: dashed;">
                                <children>
                                    <Label fx:id="lblKeyStatus" text="Trạng thái hệ thống: Đang chờ khởi tạo cặp khóa..." textFill="#475569">
                                        <font>
                                            <Font name="Segoe UI Semibold Italic" size="14.0" />
                                        </font>
                                    </Label>
                                </children>
                                <VBox.margin>
                                    <Insets top="15.0" />
                                </VBox.margin>
                            </HBox>
                        </children>
                    </VBox>
                </content>
            </Tab>

            <Tab style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold;" text="✍️ 3. Ký Số Văn Bản">
                <content>
                    <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 0 12 12 12; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 8); -fx-border-color: #e2e8f0; -fx-border-radius: 0 12 12 12; -fx-border-width: 1;">
                        <children>
                            <VBox spacing="8.0">
                                <Label text="Thực Hiện Ký Số Phê Duyệt" textFill="#0f172a">
                                    <font>
                                        <Font name="Segoe UI Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Label text="Hệ thống sẽ băm nội dung tài liệu bằng chuẩn SHA-256, sau đó dùng Private Key để mã hóa mã băm, tạo ra tệp chữ ký số (.sig) chống chối bỏ." textFill="#64748b" wrapText="true">
                                    <font>
                                        <Font name="Segoe UI" size="14.0" />
                                    </font>
                                </Label>
                            </VBox>

                            <Separator style="-fx-opacity: 0.4;" />

                            <GridPane hgap="20.0" vgap="15.0">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="150.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                    <ColumnConstraints minWidth="110.0" />
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints minHeight="45.0" />
                                </rowConstraints>
                                <children>
                                    <Label text="Tài liệu cần ký:" textFill="#1e293b">
                                        <font>
                                            <Font name="Segoe UI Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtSignDocPath" editable="false" promptText="Đường dẫn file văn bản (.txt, .pdf, .docx...)"
                                               style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 15; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Button onAction="#handleSelectSignDoc" style="-fx-background-color: #f1f5f9; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-cursor: hand;" text="Duyệt File" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                </children>
                            </GridPane>

                            <HBox alignment="CENTER_LEFT" spacing="20.0">
                                <children>
                                    <Button onAction="#handleCreateSignature" style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 14 28; -fx-effect: dropshadow(three-pass-box, rgba(249,115,22,0.3), 8, 0, 0, 3); -fx-cursor: hand;" text="Ký Số Văn Bản Đơn" />

                                    <Button onAction="#handleBatchSign" style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 14 28; -fx-effect: dropshadow(three-pass-box, rgba(139,92,246,0.3), 8, 0, 0, 3); -fx-cursor: hand;" text="Ký Hàng Loạt (Batch Mode)" />
                                </children>
                                <VBox.margin>
                                    <Insets top="15.0" />
                                </VBox.margin>
                            </HBox>
                        </children>
                    </VBox>
                </content>
            </Tab>

            <Tab style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold;" text="🛡️ 4. Xác Thực &amp; Kiểm Tra">
                <content>
                    <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 0 12 12 12; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 8); -fx-border-color: #e2e8f0; -fx-border-radius: 0 12 12 12; -fx-border-width: 1;">
                        <children>
                            <VBox spacing="8.0">
                                <Label text="Giám Định Tính Toàn Vẹn &amp; Nguồn Gốc" textFill="#0f172a">
                                    <font>
                                        <Font name="Segoe UI Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Label text="Sử dụng Public Key của người gửi để giải mã chữ ký, sau đó đối chiếu mã băm nhằm phát hiện bất kỳ sự thay đổi trái phép nào trên văn bản." textFill="#64748b" wrapText="true">
                                    <font>
                                        <Font name="Segoe UI" size="14.0" />
                                    </font>
                                </Label>
                            </VBox>

                            <Separator style="-fx-opacity: 0.4;" />

                            <GridPane hgap="20.0" vgap="18.0">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="180.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                    <ColumnConstraints minWidth="110.0" />
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints minHeight="45.0" />
                                    <RowConstraints minHeight="45.0" />
                                    <RowConstraints minHeight="45.0" />
                                </rowConstraints>
                                <children>
                                    <Label text="Văn bản cần kiểm tra:" textFill="#1e293b" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <font>
                                            <Font name="Segoe UI Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtVerifyDocPath" editable="false" promptText="Đường dẫn file văn bản hiện tại..."
                                               style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 15; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Button onAction="#handleSelectVerifyDoc" style="-fx-background-color: #f1f5f9; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-cursor: hand;" text="Duyệt File" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                                    <Label text="Chữ ký đính kèm (.sig):" textFill="#1e293b" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <font>
                                            <Font name="Segoe UI Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtVerifySigPath" editable="false" promptText="Đường dẫn file chữ ký số..."
                                               style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 15; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Button onAction="#handleSelectVerifySig" style="-fx-background-color: #f1f5f9; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-cursor: hand;" text="Duyệt File" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                                    <Label text="Public Key người gửi:" textFill="#1e293b" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <font>
                                            <Font name="Segoe UI Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="txtVerifyPubKeyPath" editable="false" promptText="Đường dẫn file Public Key (.pub)..."
                                               style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 15; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Button onAction="#handleSelectVerifyPubKey" style="-fx-background-color: #f1f5f9; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-cursor: hand;" text="Duyệt File" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                </children>
                            </GridPane>

                            <Separator style="-fx-opacity: 0.4;" />

                            <HBox alignment="CENTER_LEFT" spacing="25.0">
                                <children>
                                    <Button onAction="#handleVerifyDocument" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 14 28; -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.3), 8, 0, 0, 3); -fx-cursor: hand;" text="Tiến Hành Giám Định" />

                                    <VBox alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 12 20; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label text="BÁO CÁO KẾT QUẢ:" textFill="#64748b">
                                                <font>
                                                    <Font name="Segoe UI Semibold" size="11.0" />
                                                </font>
                                            </Label>
                                            <Label fx:id="lblVerificationResult" text="Đang chờ dữ liệu đầu vào..." textFill="#0f172a">
                                                <font>
                                                    <Font name="Segoe UI Bold" size="15.0" />
                                                </font>
                                            </Label>
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </content>
            </Tab>

            <Tab style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: bold;" text="📜 5. Lịch Sử Hoạt Động">
                <content>
                    <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 0 12 12 12; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 8); -fx-border-color: #e2e8f0; -fx-border-radius: 0 12 12 12; -fx-border-width: 1;">
                        <children>
                            <VBox spacing="5.0">
                                <Label text="Lịch Sử Hoạt Động Của Hệ Thống" textFill="#0f172a">
                                    <font>
                                        <Font name="Segoe UI Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Label text="Chi tiết danh sách các tệp tin đã thực hiện thao tác ký thuật toán RSA hoặc kiểm đối soán tính toàn vẹn dữ liệu." textFill="#64748b" />
                            </VBox>

                            <Separator style="-fx-opacity: 0.4;" />

                            <SplitPane dividerPositions="0.5" style="-fx-background-color: transparent; -fx-padding: 0; -fx-background-insets: 0;" VBox.vgrow="ALWAYS">
                                <items>
                                    <VBox spacing="10.0" style="-fx-padding: 0 15 0 0;">
                                        <children>
                                            <Label text="✍️ Nhật Ký Ký Số Văn Bản" textFill="#ea580c" style="-fx-font-weight: bold;">
                                                <font>
                                                    <Font name="Segoe UI Bold" size="14.0" />
                                                </font>
                                            </Label>
                                            <TableView fx:id="tblSignHistory" style="-fx-background-radius: 8; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colSignTime" prefWidth="130.0" text="Thời gian" />
                                                    <TableColumn fx:id="colSignDocName" prefWidth="180.0" text="Tên tài liệu gốc" />
                                                    <TableColumn fx:id="colSignStatus" prefWidth="100.0" text="Trạng thái" />
                                                </columns>
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                </columnResizePolicy>
                                            </TableView>
                                        </children>
                                    </VBox>

                                    <VBox spacing="10.0" style="-fx-padding: 0 0 0 15;">
                                        <children>
                                            <Label text="🛡️ Nhật Ký Giám Định Xác Thực" textFill="#2563eb" style="-fx-font-weight: bold;">
                                                <font>
                                                    <Font name="Segoe UI Bold" size="14.0" />
                                                </font>
                                            </Label>
                                            <TableView fx:id="tblVerifyHistory" style="-fx-background-radius: 8; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colVerifyTime" prefWidth="130.0" text="Thời gian" />
                                                    <TableColumn fx:id="colVerifyDocName" prefWidth="180.0" text="Tên tài liệu" />
                                                    <TableColumn fx:id="colVerifyResult" prefWidth="100.0" text="Kết quả" />
                                                </columns>
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                </columnResizePolicy>
                                            </TableView>
                                        </children>
                                    </VBox>
                                </items>
                            </SplitPane>
                        </children>
                    </VBox>
                </content>
            </Tab>

        </tabs>
    </TabPane>
</VBox>